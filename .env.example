PORT=3000
NODE_ENV=development
# Origen del frontend autorizado por CORS (si falta, se usa FRONTEND_URL)
CORS_ORIGIN=http://localhost:5173
# Solo detrás de un proxy inverso: saltos de proxy de confianza (p. ej. 1) para ver la IP real
# TRUST_PROXY=1
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Zona horaria por defecto para agrupar por días, semanas y meses (el navegador envía la suya)
# APP_TIMEZONE=Europe/Madrid
# PostgreSQL. En local, el de Homebrew (createdb biketelemetry); los tests usan biketelemetry_test.
# En Vercel: el "Transaction pooler" de Supabase (puerto 6543) + ?sslmode=require&uselibpqcompat=true
DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/biketelemetry"
# Solo en producción: conexión directa o "Session pooler" de Supabase (puerto 5432) para las migraciones
# DIRECT_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"
BCRYPT_ROUNDS=12

# Strava (https://www.strava.com/settings/api). "Authorization Callback Domain": localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# Adónde vuelve el navegador tras conectar con Strava
FRONTEND_URL=http://localhost:5173
# Clave para cifrar los tokens de Strava en la BD (32 bytes en hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Correo saliente para "He olvidado mi contraseña". Sin SMTP_HOST, el enlace se escribe en la consola.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación" en SMTP_PASS
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="BikeTelemetry <tu@email.com>"

# Motor de rutas ciclistas para el planificador (opcional)
# BROUTER_URL=https://brouter.de/brouter
