// Esquema de datos de BikeTelemetry
// Docs: https://pris.ly/d/prisma-schema

// prisma-client-js genera JavaScript (CommonJS), compatible con el proyecto sin compilar TS
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  // Opcionales: una cuenta creada con "Continuar con Strava" no tiene email ni contraseña
  // (la API de Strava no facilita el email); se identifica por stravaAthleteId
  email        String?   @unique
  passwordHash String?
  maxHr        Int? // FC máxima del usuario (bpm), base para las zonas de pulso
  // Perfil (registro por pasos); base de las estimaciones
  name         String?
  birthDate    DateTime?
  sex          String? // "male" | "female" | "other"
  heightCm     Int?
  weightKg     Float?
  restingHr    Int?
  createdAt    DateTime  @default(now())

  // "Continuar con Google": identificador estable de la cuenta de Google (claim sub del ID token)
  googleId     String?   @unique

  // Conexión con Strava (tokens cifrados con AES-256-GCM, ver src/utils/crypto.js)
  stravaAthleteId      String?        @unique
  stravaAccessToken    String?
  stravaRefreshToken   String?
  stravaTokenExpiresAt DateTime?
  stravaLastSyncAt     DateTime?
  activities           Activity[]
  plannedRoutes        PlannedRoute[]
}

model Activity {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  date            DateTime
  distanceKm      Float
  durationMin     Int
  avgHr           Int? // bpm (opcional)
  maxHr           Int? // bpm (opcional)
  elevationGain   Int? // metros de desnivel positivo (opcional)
  notes           String?
  source          String         @default("manual") // "manual" | "gpx" | "strava"
  sportType       String? // Ride, GravelRide, MountainBikeRide, VirtualRide, EBikeRide...
  maxSpeedKmh     Float?
  stravaId        String?        @unique
  summaryPolyline String? // Polilínea codificada (formato Google/Strava) para mapas y miniaturas
  createdAt       DateTime       @default(now())
  track           ActivityTrack?

  @@index([userId, date])
}

// Track GPS de una actividad importada (1:1). Se guarda aparte para no cargarlo al listar
model ActivityTrack {
  id         Int      @id @default(autoincrement())
  activityId Int      @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // JSON: segmentos de puntos [lat, lon, ele|null, segundosDesdeInicio|null, fc|null]
  points     String
  // JSON: versión reducida [[lat, lon], ...] por segmento, para miniaturas
  preview    String
  pointCount Int
  minLat     Float
  maxLat     Float
  minLon     Float
  maxLon     Float
  createdAt  DateTime @default(now())
}

// Ruta planificada en el mapa para exportarla al ciclocomputador
model PlannedRoute {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  routing       String // "road" | "gravel" | "trekking" | "straight"
  // JSON [[lat, lon], ...]: puntos que marca el usuario
  waypoints     String
  // JSON [[lat, lon, ele|null], ...]: trazado completo resultante
  geometry      String
  // JSON [[[lat, lon], ...]]: miniatura para los listados (null en rutas anteriores a la columna)
  preview       String?
  distanceKm    Float
  elevationGain Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, updatedAt])
}
