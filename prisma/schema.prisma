// Esquema de datos de BikeTelemetry
// Docs: https://pris.ly/d/prisma-schema

// prisma-client-js genera JavaScript (CommonJS), compatible con el proyecto sin compilar TS
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  // Opcional: una cuenta creada con "Continuar con Google" no tiene contraseña
  passwordHash String?
  maxHr        Int? // FC máxima del usuario (bpm), base para las zonas de pulso
  // Perfil (registro por pasos); base de las estimaciones
  name         String?
  birthDate    DateTime?
  sex          String? // "male" | "female" | "other"
  heightCm     Int?
  weightKg     Float?
  restingHr    Int?
  createdAt    DateTime  @default(now())

  // "Continuar con Google": identificador estable de la cuenta de Google (claim sub del ID token)
  googleId String? @unique

  connections   Connection[]
  activities    Activity[]
  plannedRoutes PlannedRoute[]
  avatar        UserAvatar?
}

// Servicio externo del que llegan salidas (Strava, iGPSPORT...). Una por usuario y servicio;
// desconectar borra la fila y las salidas importadas se conservan
model Connection {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "strava" | "igpsport"
  // Cuenta en el servicio (id de atleta de Strava, email de iGPSPORT...)
  account        String?
  // Tokens cifrados con AES-256-GCM (ver src/utils/crypto.js)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  // Una cuenta de un servicio solo puede estar conectada a un usuario
  @@unique([provider, account])
}

// Foto de perfil (1:1), aparte para no cargarla con el usuario. Se sirve en /api/avatars/:id:
// el id es aleatorio y cambia en cada subida, así la URL puede cachearse para siempre
model UserAvatar {
  id          String   @id @default(uuid())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String // "image/jpeg" | "image/png" | "image/webp"
  createdAt   DateTime @default(now())
}

model Activity {
  id              Int              @id @default(autoincrement())
  userId          Int
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  date            DateTime
  distanceKm      Float
  durationMin     Int
  avgHr           Int? // bpm (opcional)
  maxHr           Int? // bpm (opcional)
  elevationGain   Int? // metros de desnivel positivo (opcional)
  notes           String?
  // De dónde salen los datos: "manual" | "gpx" | "strava"
  source          String           @default("manual")
  sportType       String? // Ride, GravelRide, MountainBikeRide, VirtualRide, EBikeRide...
  maxSpeedKmh     Float?
  summaryPolyline String? // Polilínea codificada (formato Google/Strava) para mapas y miniaturas
  createdAt       DateTime         @default(now())
  track           ActivityTrack?
  imports         ActivityImport[]

  @@index([userId, date])
}

// Salida de un servicio externo que corresponde a esta actividad. Una actividad puede tener varias
// (la misma salida en Strava y en iGPSPORT): así cada sincronización sabe qué no volver a traer
model ActivityImport {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  provider   String // "strava" | "igpsport"
  externalId String // id de la salida en ese servicio
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@index([activityId])
}

// Track GPS de una actividad importada (1:1). Se guarda aparte para no cargarlo al listar
model ActivityTrack {
  id         Int      @id @default(autoincrement())
  activityId Int      @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // JSON: segmentos de puntos [lat, lon, ele|null, segundosDesdeInicio|null, fc|null]
  points     String
  // JSON: versión reducida [[lat, lon], ...] por segmento, para miniaturas
  preview    String
  pointCount Int
  minLat     Float
  maxLat     Float
  minLon     Float
  maxLon     Float
  createdAt  DateTime @default(now())
}

// Ruta planificada en el mapa para exportarla al ciclocomputador
model PlannedRoute {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  routing       String // "road" | "gravel" | "trekking" | "straight"
  // JSON [[lat, lon], ...]: puntos que marca el usuario
  waypoints     String
  // JSON [[lat, lon, ele|null], ...]: trazado completo resultante
  geometry      String
  // JSON [[[lat, lon], ...]]: miniatura para los listados (null en rutas anteriores a la columna)
  preview       String?
  distanceKm    Float
  elevationGain Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, updatedAt])
}
