{
  "name": "cycling-stats",
  "version": "1.0.0",
  "description": "BikeTelemetry - registro y análisis de entrenamientos en bicicleta",
  "main": "src/server.js",
  "scripts": {
    "test": "node --import ./tests/helpers/env.js --test --test-concurrency=1 'tests/**/*.test.js'",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "pretest": "node tests/helpers/prepare-db.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "lint": "oxlint src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tmcw/togeojson": "^7.1.2",
    "@vercel/functions": "^3.9.9",
    "@xmldom/xmldom": "^0.9.12",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "oxlint": "^1.85.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0"
  }
}
